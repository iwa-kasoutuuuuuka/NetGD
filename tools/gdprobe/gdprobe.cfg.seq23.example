# gdprobe run configuration for seq 23: what the STOCK GDEMU returns (bytes, CRC-32 per sector) in the pregaps
# (FAD 0/1/100/149, start -156..0 of every later track) and for 16-sector reads across boundaries (pregap -> body,
# gap -> pregap, data end -> gap, lead-outs); the seq 22 cases run again with CRCs. Count 0 stays a whitelist skip.
# All FADs come from each image's TOC at run time. Copy to <host folder>/gdprobe.cfg. See README_ja.md, "seq 23".

label=stock
seq=23

# 4 = Mode 2 Form 1 CDI, 3 = GDI, 10 = Mode 1 CDI (11 = audio-only CDI: add it for a single-session image)
switch=on
images=4,3,10
#images=4,3,10,11
return_to=2
switch_timeout_ms=5000

# the swap-window / reset probes and the seq 21 head cases: all off
swap_regpoll=off
swap_devreset=off
swap_reswitch=off
devreset_only=off
devreset_cmd=off
head_probe=off

# battery IP_READ with 0x20 (no CHECK on the CDIs); no flag battery, throughput or seek
cdread_flags=0x20
cdread_flags_test=off
throughput=off
seek=off
identify=off

# the TOC-edge cases after each image's battery (GP_* lines)
gap_probe=on
gap_flags=0x20
gap_late_ms=300
gap_scd=on
gap_track_end=0
gap_leadout=0,1,100
gap_low=0,100
gap_count0=on

# seq 23: CRCs on every GP_ read, pregap and crossing reads
gap_crc=on
pregap_probe=on
pregap_low=0,1,100,149
pregap_offs=-156,-151,-150,-149,-100,-2,-1,0
pregap_cross=16
