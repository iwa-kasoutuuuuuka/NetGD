# gdprobe run configuration for seq 25c (seq=27): CD_READ by G1 DMA on the stock GDEMU, images 3, 4, 11.
# Record 26: an unaligned `exact` audio DMA (2352) completes but the engine writes up to the next 32-byte boundary (2368: 16
# bytes past the requested length); `floor` (2336) completes the DMA and then the drive stays BSY with the last 16 bytes:
# every later command timed out and the run aborted. So: dma_modes=exact only (floor / pad are opt-in and run last, after all
# images and the throughput), audio 1/2/7/16 exact with the overrun bytes recorded (over_n=, over_hex=, DM_*_OVER over_eq_next=),
# data 1/2/7/16 and the data throughput. Read-only, every wait bounded, an incomplete DMA stops only its own kind.

label=stock
seq=27

# 3 = GDI (data, audio track 2), 4 = Mode 2 Form 1 CDI (audio track 1 + data), 11 = audio-only CDI
switch=on
images=3,4,11
return_to=2
switch_timeout_ms=5000

# the swap-window / reset probes and everything of seq 21-24: off
swap_regpoll=off
swap_devreset=off
swap_reswitch=off
devreset_only=off
devreset_cmd=off
head_probe=off
gap_probe=off
pregap_probe=off
ctl_probe=off

# battery IP_READ with 0x20; no flag battery, throughput or seek (the DMA throughput below replaces them)
cdread_flags=0x20
cdread_flags_test=off
throughput=off
seek=off
identify=off

# seq 25
dma_probe=on
dma_data=on
dma_audio=on
dma_counts=1,2,7,16
dma_modes=exact
dma_flags=0x20
dma_pio_ref=on
dma_timeout_ms=3000
dma_late_ms=300
dma_scd=on
dma_throughput=on
dma_tp_batches=64
dma_tp_max_ms=10000
